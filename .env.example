# Set hostname resolvable by LAN clients; default binds only to localhost.
LEASEDD_HOST=localhost
LEASEDD_BIND_IP=127.0.0.1
# Use URL-safe randomly generated passwords; never commit .env.
POSTGRES_PASSWORD=
LEASEDD_ADMIN_USER=admin
LEASEDD_ADMIN_PASSWORD=
# Optional. Configure Agnes base URL and model in the admin page.
AGNES_API_KEY=
# Existing MinerU service on the Docker host.
MINERU_URL=http://host.docker.internal:58000
